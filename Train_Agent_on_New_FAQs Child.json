    {
      "parameters": {
        "jsCode": "// Pair each embedding result back to its FAQ id by index\nconst inputs = $('Combine Question + Answer').all();\nconst results = $input.all();\n\nconst out = [];\nfor (let i = 0; i < results.length; i++) {\n  out.push({\n    json: {\n      id: inputs[i].json.id,\n      embedding: JSON.stringify(results[i].json.data[0].embedding)\n    }\n  });\n}\n\nreturn out;\n"
      },
