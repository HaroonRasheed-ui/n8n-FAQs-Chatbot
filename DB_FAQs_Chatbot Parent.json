      ],
      "id": "61832a68-e56b-41b9-b392-04981ef9ce43",
      "name": "Check if FAQ Exists"
    },
    {
      "parameters": {
        "jsCode": "// ===== Build friendly rewrite prompt from DB answer =====\nconst question = $('Normalize SAP term').item.json.question || \"No question provided.\";\nconst answer = $json.answer || \"\";\n\nconst prompt = `\nYou are a warm, intelligent, and supportive AI assistant who helps users by explaining things clearly and kindly.\n\nYour task:\n- Understand the user's question carefully.\n- If an answer exists, rewrite it in a friendly, conversational, and natural way.\n- The answer should sound supportive and easy to follow, like a helpful coworker explaining it.\n- Avoid using markdown formatting like *, **, _, or numbered lists (1., 2., 3.).\n- Use plain text with short paragraphs and natural line breaks.\n- Always keep a positive and reassuring tone.\n- You can add small helpful notes, like suggesting to contact an admin or offering additional help.\n\nQuestion:\n${question}\n\nExisting Answer:\n${answer || \"No existing answer found.\"}\n\nNow, write the best possible answer in a friendly, supportive tone, directly addressing the question.\n`;\n\nreturn [\n  {\n    json: {\n      prompt,\n      question,\n      answer\n    }\n  }\n];\n"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        320,
        -320
      ],
      "id": "56e3d025-f993-45bc-b1ea-2eebd0f60405",
      "name": "Prompt for the Agent1"
    },
    {
      "parameters": {
        "model": {
          "__rl": true,
          "mode": "list",
          "value": "gpt-4.1-mini"
        },
        "options": {}
      },
