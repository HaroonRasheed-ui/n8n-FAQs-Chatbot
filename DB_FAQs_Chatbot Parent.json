      ],
      "id": "2d59a56e-dcf4-4610-bb21-92cbb4dbb5ae",
      "name": "Respond to Chat Input"
    },
    {
      "parameters": {
        "jsCode": "// ===== Build prompt for unknown question (uses ORIGINAL user question) =====\nconst userQuestion = $('Normalize SAP term').item.json.question || \"No question provided\";\nconst sessionId = $('Normalize SAP term').item.json.sessionId || \"default-session\";\n\nconst prompt = `\nYou are a helpful FAQ assistant for a company.\nA user asked the following question that was not found in the FAQ database:\n\nQuestion: \"${userQuestion}\"\n\nYour tasks:\n1. Give a short, clear, and accurate answer using your best general knowledge.\n2. If the question is unclear or subjective, give your best helpful guidance.\n3. Keep your answer friendly and easy to read.\n4. Do not mention that it wasn't found in the database.\n5. Respond naturally like a human expert.\n6. Respond ONLY with raw JSON, no markdown fences, in this exact shape:\n{\n  \"question\": \"user question here\",\n  \"ai_answer\": \"your generated answer here\"\n}\n`;\n\nreturn [\n  {\n    json: {\n      prompt,\n      question: userQuestion,\n      sessionId\n    }\n  }\n];\n"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        144,
        64
      ],
      "id": "816ee60a-27fa-4271-87dc-bdc05f413499",
      "name": "Prompt for Agent2"
