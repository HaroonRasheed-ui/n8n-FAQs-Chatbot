    {
      "parameters": {
        "jsCode": "// Normalize SAP -> SAP B1, carry sessionId forward\nlet question = $json[\"question\"] || \"\";\nquestion = question.replace(/\\bSAP\\b/gi, \"SAP B1\");\n\nreturn [\n  {\n    json: {\n      question,\n      sessionId: $json.sessionId || \"default-session\"\n    }\n  }\n];\n"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -896,
        -336
      ],
      "id": "1d26b99f-010e-458b-a66d-c314c68de077",
      "name": "Normalize SAP term"
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://api.openai.com/v1/embeddings",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "openAiApi",
        "sendBody": true,
        "bodyParameters": {
          "parameters": [
            {
              "name": "model",
              "value": "text-embedding-3-small"
            },
            {
              "name": "input",
              "value": "={{ $json[\"question\"] }}"
            }
          ]
        },
        "options": {}
      },
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        -752,
        -336
      ],
      "id": "a017fcd2-1ba8-4ec8-af6c-1efb3fe363d9",
      "name": "Embed User Question"
    },
    {
      "parameters": {
        "jsCode": "// Build vector string for pgvector + keep question/sessionId\nconst question = $('Normalize SAP term').item.json.question;\nconst sessionId = $('Normalize SAP term').item.json.sessionId;\nconst vector = JSON.stringify($json.data[0].embedding);\n\nreturn [\n  {\n    json: {\n      question,\n      sessionId,\n      vector\n    }\n  }\n];\n"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -432,
        -320
      ],
      "id": "273a3c0c-b04d-4225-813c-0bbcfc0d9307",
      "name": "Prepare Vector"
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT\n  id,\n  question,\n  answer,\n  1 - (embedding <=> $1::vector) AS similarity\nFROM faqs\nWHERE embedding IS NOT NULL\nORDER BY embedding <=> $1::vector\nLIMIT 1;",
        "options": {
          "queryReplacement": "={{ [$json.vector] }}"
        }
      },
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.6,
      "position": [
        -176,
        -320
      ],
      "id": "fa50631a-0489-44a3-bb1a-9b4efff653f5",
      "name": "Get the Q and A from DB",
      "alwaysOutputData": true,
      "credentials": {
        "postgres": {
          "id": "MwC1yijgmrukymoC",
          "name": "Postgres account"
        }
      }
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict",
            "version": 2
          },
          "conditions": [
            {
              "id": "4e3dd9eb-8b82-408f-a063-15188ecce72a",
              "leftValue": "={{ $json.similarity || 0 }}",
              "rightValue": 0.5,
              "operator": {
                "type": "number",
                "operation": "gte"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
