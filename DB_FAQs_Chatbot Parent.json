    {
      "parameters": {
        "jsCode": "// ===== Clean final reply text =====\nlet text = ($json.answer || \"\")\n  .replace(/\\\\n/g, \"\\n\")\n  .replace(/\\\\r/g, \"\")\n  .trim();\n\nif (!text) {\n  text = \"I'm sorry, I don't have an answer for that right now.\";\n}\n\nreturn [\n  {\n    json: {\n      reply: text\n    }\n  }\n];\n"
      },
