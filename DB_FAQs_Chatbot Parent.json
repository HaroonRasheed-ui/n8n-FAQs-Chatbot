      "id": "278048fb-4f59-4492-9bf1-e8ca9469005b",
      "name": "Generate Answer"
    },
    {
      "parameters": {
        "jsCode": "// ===== Parse agent JSON output, with safe fallbacks =====\nconst raw = $json.output || \"\";\n\n// Strip possible markdown fences\nconst cleaned = raw.replace(/```json|```/gi, \"\").trim();\n\nlet parsed = {};\ntry {\n  parsed = JSON.parse(cleaned);\n} catch (error) {\n  parsed = {};\n}\n\nconst question =\n  parsed.question?.trim() ||\n  $('Normalize SAP term').item.json.question ||\n  \"No question found.\";\n\nconst answer =\n  parsed.ai_answer?.trim() ||\n  parsed.answer?.trim() ||\n  cleaned ||\n  \"No answer found.\";\n\nreturn [\n  {\n    json: {\n      question,\n      answer\n    }\n  }\n];\n"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        736,
        64
      ],
      "id": "751be377-6103-4d26-ba05-488b4504c616",
      "name": "Code in JavaScript1"
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "INSERT INTO faqs (question, answer, learned)\nVALUES ($1, $2, false);",
        "options": {
          "queryReplacement": "={{ [$json[\"question\"], $json[\"answer\"]] }}"
        }
      },
