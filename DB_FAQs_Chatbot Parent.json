      ],
      "id": "06b3dec9-54a4-4ea0-ac9a-a611fb72cc80",
      "name": "Elaborate the Answer"
    },
    {
      "parameters": {
        "jsCode": "// Pass the agent answer through as reply\nconst input = $json;\nconst answer = input.output || input.answer || \"I'm sorry, I don't have an answer for that.\";\n\nreturn [\n  {\n    json: {\n      reply: answer\n    }\n  }\n];\n"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
